# MoveSure Environment Configuration

# Flask Web Server
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
SECRET_KEY=movesure-super-secret-key-change-in-production

# Node.js Server
PORT=3000
MONGO_URI=mongodb://localhost:27017/movesure

# Camera & Vision Settings
CAMERA_INDEX=0
POSTURE_MODEL_PATH=backend/models/posture_model.joblib

# Speech & Alert Settings
AUDIO_FEEDBACK_ENABLED=true
AUDIO_COOLDOWN_SECONDS=4
